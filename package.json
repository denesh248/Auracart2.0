{
  "name": "auracart",
  "version": "1.0.0",
  "author": "Denesh Kumar",
  "description": "AuraCart",
  "scripts": {
    "install-all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "build": "cd frontend && npm run build",
    "start": "python ./backend/manage.py runserver 5000",
    "dev": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "python ./backend/manage.py runserver 5000",
    "start:frontend": "npm --prefix frontend start",
    "seed": "python ./backend/manage.py seed_data"
  },
  "dependencies": {
    "concurrently": "^8.2.1"
  }
}